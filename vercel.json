{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/bot",
      "framework": "express",
      "entrypoint": "server.mjs",
      "buildCommand": "npm run build",
      "installCommand": "npm ci --prefix ../.. && npm --prefix ../.. run build:shared"
    },
    "mini-app": {
      "root": "apps/mini-app",
      "framework": "vite",
      "installCommand": "npm ci --prefix ../.. && npm --prefix ../.. run build:shared"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "mini-app"
      }
    }
  ]
}
