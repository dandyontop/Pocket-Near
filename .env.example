NODE_ENV=development
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgres://pocket_near:pocket_near@localhost:5432/pocket_near
# Optional Supabase Vercel integration variable; takes precedence over DATABASE_URL.
POSTGRES_URL=
DATABASE_SSL=false
# Optional Supabase root CA PEM. When set, the database certificate is verified.
DATABASE_SSL_CA=
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Shared bearer secret for Vercel Schedules and the GitHub Actions fallback.
CRON_SECRET=replace-with-a-long-random-secret
# Optional for public dry quote requests; configure a partner JWT only if the provider requires it.
ONE_CLICK_JWT=
ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
# Required on the API server for authenticated NEAR Intents Explorer metrics.
EXPLORER_JWT=
NEAR_RPC_URL=https://rpc.mainnet.near.org
SOLVER_RELAY_URL=https://solver-relay-v2.chaindefuser.com/rpc
ALLOWED_ORIGINS=http://localhost:5173
QUOTE_CACHE_TTL_SECONDS=20
MAX_INIT_DATA_AGE_SECONDS=600
AGENT_WORKER_ENABLED=false
AGENT_WORKER_INTERVAL_MS=30000
TEE_SIGNER_ENABLED=false
TEE_SIGNER_URL=
TEE_SIGNER_API_KEY=
DEV_ENCLAVE_PRIVATE_KEY=
COINGECKO_API_KEY=
PRICE_ASSET_IDS=bitcoin,ethereum,solana,near,usd-coin,tether,chainlink,avalanche-2,wrapped-bitcoin
PRICES_CACHE_TTL_SECONDS=45
EARN_CACHE_TTL_SECONDS=600
MARKET_CACHE_TTL_SECONDS=90
